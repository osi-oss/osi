{
    "name": "Permissions Management",
    "item": [
        {
            "name": "1. Get All Permissions",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status code is 200', function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test('Response has permissions array', function () {",
                            "    var jsonData = pm.response.json();",
                            "    pm.expect(jsonData).to.have.property('permissions');",
                            "    pm.expect(jsonData.permissions).to.be.an('array');",
                            "    pm.expect(jsonData.permissions.length).to.be.above(0);",
                            "});",
                            "",
                            "pm.test('Permissions have required fields', function () {",
                            "    var jsonData = pm.response.json();",
                            "    var firstPerm = jsonData.permissions[0];",
                            "    pm.expect(firstPerm).to.have.property('code');",
                            "    pm.expect(firstPerm).to.have.property('description');",
                            "    pm.expect(firstPerm).to.have.property('group_name');",
                            "});",
                            "",
                            "// Save permission codes for later use",
                            "if (pm.response.code === 200) {",
                            "    var jsonData = pm.response.json();",
                            "    var perms = jsonData.permissions;",
                            "    ",
                            "    // Find and save specific permission codes",
                            "    var membersView = perms.find(p => p.code === 'members.view');",
                            "    var permissionsGrant = perms.find(p => p.code === 'permissions.grant');",
                            "    var permissionsRevoke = perms.find(p => p.code === 'permissions.revoke');",
                            "    ",
                            "    if (membersView) {",
                            "        console.log('✓ Found members.view permission');",
                            "    }",
                            "    if (permissionsGrant) {",
                            "        console.log('✓ Found permissions.grant permission');",
                            "    }",
                            "    if (permissionsRevoke) {",
                            "        console.log('✓ Found permissions.revoke permission');",
                            "    }",
                            "    ",
                            "    console.log('Total permissions:', perms.length);",
                            "}"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/api/organizations/{{org_id}}/permissions",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "organizations",
                        "{{org_id}}",
                        "permissions"
                    ]
                },
                "description": "Получение списка всех доступных прав в системе.\n\n**Требуется:** Доступ к организации"
            }
        },
